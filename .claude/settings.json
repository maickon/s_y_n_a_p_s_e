{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(node .claude/scripts/check.mjs:*)",
      "Bash(npx tailwindcss@3.4.16 -i css/tw.src.css -o css/tw.css --minify)",
      "Bash(grep:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Read(./vendor/**)",
      "Read(./css/tw.css)",
      "Read(./desktop/src-tauri/Cargo.lock)",
      "Read(./desktop/package-lock.json)",
      "Read(./desktop/src-tauri/icons/**)",
      "Read(./desktop/node_modules/**)",
      "Read(./desktop/dist/**)",
      "Read(./desktop/src-tauri/target/**)",
      "Read(./desktop/src-tauri/gen/**)",
      "Bash(git push:*)"
    ]
  }
}

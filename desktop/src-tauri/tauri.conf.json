{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNAPSE",
  "version": "0.1.0",
  "identifier": "com.maickon.synapse",
  "build": {
    "beforeBuildCommand": "npm run copy",
    "beforeDevCommand": "npm run copy",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "S.Y.N.A.P.S.E",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDM0YxNTlBNjlCMkRBNDUKUldSRjJySnBtaFUvL0NJc3VuZHo2MUpFTVN1WlBKbGJBeWxtUHd6NzVmS2h1Y1RGbWtvVmttbWQK",
      "endpoints": [
        "https://github.com/maickon/s_y_n_a_p_s_e/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}